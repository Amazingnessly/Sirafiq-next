{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
    "worker/**/*.ts",
    "src/shared/**/*.ts",
    "src/buildIdentity.ts",
    "src/sirafiq-globals.d.ts"
  ]
}
