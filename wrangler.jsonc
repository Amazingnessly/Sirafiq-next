{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sirafiq-next",
  "main": "./worker/entry.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sirafiq-next-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "sirafiq-next-files"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "sirafiq-next-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
